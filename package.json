{
  "name": "kaalkeyauthenticator",
  "version": "1.1.22",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~57.0.9",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "crypto-js": "^4.2.0",
    "expo": "~57.0.32",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.5",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.21",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.30",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.25",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "otpauth": "^9.5.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.2.4",
    "concurrently": "^9.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "wait-on": "^8.0.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "android:release": "expo run:android --variant release",
    "desktop:dev": "concurrently -k \"expo start --web --host localhost\" \"wait-on http://localhost:8081 && npx electron --disable-gpu electron/main.cjs\"",
    "desktop:export": "expo export --platform web",
    "desktop:build": "npm run desktop:export && electron-builder",
    "desktop:build:linux": "npm run desktop:export && electron-builder --linux"
  },
  "private": true,
  "build": {
    "appId": "com.techsivaram.kaalkey.desktop",
    "productName": "KaalKey Authenticator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json",
      "assets/images/kaalkey-logo-opaque.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/images/kaalkey-logo-opaque.png",
      "category": "Utility",
      "synopsis": "Cross-platform authenticator",
      "description": "KaalKey Authenticator generates and manages time-based one-time passwords.",
      "maintainer": "TechSivaram <sivaram@techsivaram.com>",
      "desktopName": "KaalKey Authenticator"
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    }
  }
}
