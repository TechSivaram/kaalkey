{
  "expo": {
    "name": "KaalKey Authenticator",
    "slug": "KaalKeyAuthenticator",
    "version": "1.1.16",
    "orientation": "portrait",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/kaalkey-adaptive-icon-safe.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ],
      "package": "com.techsivaram.kaalkey.authenticator",
      "softwareKeyboardLayoutMode": "resize"
    },
    "icon": "./assets/images/kaalkey-adaptive-icon-safe.png",
    "scheme": "kaalkeyauthenticator",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow KaalKey Authenticator to use Face ID to protect access to your verification codes."
      }
    },
    "web": {
      "favicon": "./assets/images/kaalkey-logo-opaque.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/kaalkey-splash-safe.png",
          "imageWidth": 320
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-local-authentication",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "hidden": false,
      "translucent": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b953db38-68e4-4ae4-a660-853b72957230"
      }
    }
  }
}
