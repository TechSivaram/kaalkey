{
  "expo": {
    "name": "KaalKey Authenticator",
    "slug": "KaalKeyAuthenticator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kaalkey-logo-opaque.png",
    "scheme": "kaalkeyauthenticator",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/kaalkey-logo-opaque.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/kaalkey-logo-opaque.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/kaalkey-full-logo-white.png",
          "imageWidth": 320
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "hidden": false,
      "translucent": false
    }
  }
}
